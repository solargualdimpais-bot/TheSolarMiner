[Unit]
Description=SolarMiner offline atomic release recovery (independent of Gateway API)
Documentation=file:/usr/share/doc/solarminer-gateway/UPDATE_AND_ROLLBACK.md
DefaultDependencies=yes
After=local-fs.target
RequiresMountsFor=/var/lib/solarminer

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/solarminer-recovery
ExecStartPre=/usr/bin/solarminer-data-volume-check
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/solarminer /var/lib/solarminer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
