#!/bin/sh
# Installs the pinned OpenClaude runtime only after Tailnet and TLS are verified.
set -eu

LOG=/var/log/solarminer-intelligence-bootstrap.log
mkdir -p /var/log /var/lib/solarminer/intelligence
touch "$LOG"
chmod 0600 "$LOG"
log() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" | tee -a "$LOG"; }
STATUS_FILE=/var/lib/solarminer/intelligence-bootstrap-status.json
READY_FILE=/var/lib/solarminer-intelligence/agent-ready
CURRENT_STAGE=checking_prerequisites
write_status() {
  status_state=${1:-running}; status_stage=${2:-$CURRENT_STAGE}; status_message=${3:-A verificar a instalação.}
  status_percent=${4:--}; status_downloaded=${5:--}; status_total=${6:--}
  if ! python3 - "$STATUS_FILE" "$status_state" "$status_stage" "$status_message" "$status_percent" "$status_downloaded" "$status_total" <<'PY'
import grp, json, os, sys, tempfile, time
path, state, stage, message, percent, downloaded, total = sys.argv[1:]
def number(value):
    return int(value) if value.isdigit() else None
payload = {"state": state, "stage": stage, "message": message[:180], "percent": number(percent),
           "downloaded_bytes": number(downloaded), "total_bytes": number(total), "updated_at": time.time()}
directory = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(prefix=".intelligence-bootstrap-status-", dir=directory)
try:
    os.fchown(fd, 0, grp.getgrnam("solarminer").gr_gid)
    os.fchmod(fd, 0o640)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(payload, stream, separators=(",", ":"))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
    directory_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try: os.fsync(directory_fd)
    finally: os.close(directory_fd)
finally:
    try: os.unlink(temporary)
    except FileNotFoundError: pass
PY
  then log "WARNING: não foi possível atualizar o estado visível do bootstrap."; fi
}
fail() { rm -f "$READY_FILE" 2>/dev/null || true; write_status failed "$CURRENT_STAGE" "A instalação falhou nesta etapa. Consulta o registo do bootstrap."; log "ERROR: $*"; exit 1; }

STATE=/var/lib/solarminer/intelligence/runtime-installed
[ "$(id -u)" -eq 0 ] || fail "bootstrap exige root"
rm -f "$READY_FILE"
write_status running "$CURRENT_STAGE" "A verificar os pré-requisitos de segurança."
command -v tailscale >/dev/null 2>&1 || fail "Tailscale não está instalado"
command -v curl >/dev/null 2>&1 || fail "curl não está instalado"
command -v python3 >/dev/null 2>&1 || fail "Python 3 não está instalado"
command -v tar >/dev/null 2>&1 || fail "tar não está instalado"
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum não está instalado"
command -v zstd >/dev/null 2>&1 || fail "zstd não está instalado; dependência do pacote verificado ausente"

TAILSCALE_JSON=$(tailscale status --json 2>/dev/null) || fail "Tailscale ainda não está autorizado"
TAILSCALE_DNS=$(printf '%s' "$TAILSCALE_JSON" | python3 -c '
import json,re,sys
try:
 d=json.load(sys.stdin); s=d.get("Self") or {}; n=(s.get("DNSName") or "").rstrip(".").lower()
 if d.get("BackendState") != "Running" or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\.ts\.net", n): raise ValueError()
 print(n)
except Exception: raise SystemExit(1)
' 2>/dev/null) || fail "Tailscale não está em estado Running com DNS MagicDNS válido"
[ -s /etc/solarminer/tailscale.crt ] && [ -s /etc/solarminer/tailscale.key ] || fail "certificado TLS Tailscale ausente"
grep -Fq "server_name $TAILSCALE_DNS;" /etc/nginx/conf.d/solarminer-tailscale.conf || fail "vhost TLS não corresponde ao DNS Tailscale"
HEALTH=$(mktemp)
LOCAL_HEALTH=
trap 'rm -f "$HEALTH" "$LOCAL_HEALTH"' EXIT HUP INT TERM
curl --fail --silent --show-error --max-time 10 --resolve "$TAILSCALE_DNS:443:127.0.0.1" \
  "https://$TAILSCALE_DNS/api/v1/health" --output "$HEALTH" || fail "a verificação HTTPS/TLS MagicDNS falhou"
python3 - "$HEALTH" <<'PY' || fail "health HTTPS não confirmou status=ok"
import json,sys
with open(sys.argv[1],encoding="utf-8") as f: payload=json.load(f)
raise SystemExit(0 if payload.get("status")=="ok" else 1)
PY
log "Tailscale autorizado e HTTPS/TLS validado para $TAILSCALE_DNS. A instalação do runtime pode começar."
LOCAL_HEALTH=$(mktemp)
curl --fail --silent --show-error --max-time 10 --cacert /var/lib/solarminer/server.crt \
  "https://localhost:8443/api/v1/health" --output "$LOCAL_HEALTH" || fail "TLS/certificado da API local não validou para o canal MCP"
python3 - "$LOCAL_HEALTH" <<'PY' || fail "health TLS local não confirmou status=ok"
import json,sys
with open(sys.argv[1],encoding="utf-8") as f: payload=json.load(f)
raise SystemExit(0 if payload.get("status")=="ok" else 1)
PY
rm -f "$LOCAL_HEALTH"
log "Canal TLS local do Gateway validado para a ligação MCP."

NODE_VERSION=24.22.1
NODE_SHA256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
OPENCLAUDE_VERSION=0.36.0
OLLAMA_VERSION=0.40.16
OLLAMA_INSTALLER_SHA256=25f64b810b947145095956533e1bdf56eacea2673c55a7e586be4515fc882c9f
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
ARCHIVE="node-v${NODE_VERSION}-linux-x64.tar.xz"
BASE=/opt/solarminer/intelligence
NODE_DIR="$BASE/node-v$NODE_VERSION"
APP_DIR="$BASE/app"
mkdir -p "$BASE"
TMP=$(mktemp -d "$BASE/.bootstrap.XXXXXX")
trap 'rm -rf "$TMP" "$HEALTH"; [ -z "$LOCAL_HEALTH" ] || rm -f "$LOCAL_HEALTH"' EXIT HUP INT TERM

# Ollama is installed only after the Tailscale identity, public TLS endpoint,
# and local Gateway TLS endpoint have all passed above. Its installer is
# pinned and hash-checked; inference and model pulls remain loopback-only.
if ! command -v ollama >/dev/null 2>&1 || ! ollama --version 2>&1 | grep -Fq "$OLLAMA_VERSION"; then
  CURRENT_STAGE=installing_ollama
  write_status running "$CURRENT_STAGE" "A instalar o Ollama local."
  log "A instalar Ollama $OLLAMA_VERSION pelo instalador oficial verificado."
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    "https://github.com/ollama/ollama/releases/download/v$OLLAMA_VERSION/install.sh" \
    -o "$TMP/ollama-install.sh" || fail "download do instalador oficial Ollama falhou"
  printf '%s  %s\n' "$OLLAMA_INSTALLER_SHA256" "$TMP/ollama-install.sh" | sha256sum --check --status || fail "hash do instalador Ollama não corresponde"
  OLLAMA_VERSION="$OLLAMA_VERSION" /bin/sh "$TMP/ollama-install.sh" >>"$LOG" 2>&1 || fail "instalação oficial Ollama falhou"
fi
CURRENT_STAGE=starting_ollama
write_status running "$CURRENT_STAGE" "A iniciar e verificar o serviço Ollama local."
install -d -o root -g root -m 0755 /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/solarminer.conf <<'EOF'
[Service]
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_CONTEXT_LENGTH=8192
EOF
chmod 0644 /etc/systemd/system/ollama.service.d/solarminer.conf
systemctl daemon-reload
systemctl enable --now ollama.service || fail "serviço Ollama não iniciou"
OLLAMA_READY=0
for attempt in $(seq 1 60); do
  if curl --fail --silent --max-time 2 http://127.0.0.1:11434/api/version -o "$TMP/ollama-version.json"; then OLLAMA_READY=1; break; fi
  sleep 1
done
[ "$OLLAMA_READY" -eq 1 ] || fail "API local do Ollama não ficou disponível em 127.0.0.1"
if ! ollama list 2>>"$LOG" | awk -v model="$OLLAMA_MODEL" 'NR > 1 && $1 == model { found=1 } END { exit !found }'; then
  CURRENT_STAGE=downloading_model
  write_status running "$CURRENT_STAGE" "A iniciar o download do modelo Ollama."
  log "A descarregar o modelo local $OLLAMA_MODEL; esta transferência pode demorar e ocupar vários gigabytes."
  python3 - "$OLLAMA_MODEL" "$STATUS_FILE" <<'PY' || fail "download do modelo local Ollama falhou"
import grp, json, os, sys, tempfile, time
from urllib.request import Request, urlopen

model, status_path = sys.argv[1:]
layers = {}
last_write = 0.0
last_percent = -1

def write_status(percent, downloaded, total, message):
    global last_write, last_percent
    now = time.time()
    if percent == last_percent and now - last_write < 2:
        return
    payload = {"state":"running", "stage":"downloading_model", "message":message[:180],
               "percent":percent, "downloaded_bytes":downloaded, "total_bytes":total, "updated_at":now}
    directory = os.path.dirname(status_path)
    fd, temporary = tempfile.mkstemp(prefix=".intelligence-bootstrap-status-", dir=directory)
    try:
        os.fchown(fd, 0, grp.getgrnam("solarminer").gr_gid)
        os.fchmod(fd, 0o640)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, separators=(",", ":")); stream.write("\n")
            stream.flush(); os.fsync(stream.fileno())
        os.replace(temporary, status_path)
    finally:
        try: os.unlink(temporary)
        except FileNotFoundError: pass
    last_write, last_percent = now, percent

request = Request("http://127.0.0.1:11434/api/pull",
                  data=json.dumps({"name":model,"stream":True}).encode("utf-8"),
                  headers={"Content-Type":"application/json"}, method="POST")
finished = False
with urlopen(request, timeout=120) as response:
    for raw_line in response:
        if not raw_line.strip():
            continue
        event = json.loads(raw_line.decode("utf-8"))
        if event.get("error"):
            raise RuntimeError("ollama_pull_failed")
        digest = event.get("digest")
        if isinstance(digest, str) and isinstance(event.get("total"), int):
            layers[digest] = (max(0, int(event.get("completed") or 0)), max(0, int(event["total"])))
        total = sum(item[1] for item in layers.values())
        downloaded = sum(min(item[0], item[1]) for item in layers.values())
        percent = min(100, int(downloaded * 100 / total)) if total else None
        status = str(event.get("status") or "")
        if status == "success":
            finished = True
            write_status(100, total, total, "Download do modelo concluído; a verificar a resposta local.")
        elif percent is not None:
            write_status(percent, downloaded, total, "A descarregar o modelo Ollama.")
        else:
            write_status(None, None, None, "A preparar o download do modelo Ollama.")
if not finished:
    raise RuntimeError("ollama_pull_did_not_complete")
PY
fi
CURRENT_STAGE=model_smoke_test
write_status running "$CURRENT_STAGE" "A testar a resposta local do modelo."
curl --fail --silent --show-error --max-time 600 http://127.0.0.1:11434/api/generate \
  -H 'Content-Type: application/json' \
  --data-binary "{\"model\":\"$OLLAMA_MODEL\",\"prompt\":\"Responde apenas com OK.\",\"stream\":false,\"options\":{\"num_ctx\":8192,\"num_predict\":16}}" \
  -o "$TMP/ollama-smoke.json" || fail "teste local de inferência Ollama falhou"
python3 - "$TMP/ollama-smoke.json" <<'PY' || fail "modelo Ollama não passou no teste local de resposta"
import json,sys
with open(sys.argv[1],encoding="utf-8") as stream: result=json.load(stream)
raise SystemExit(0 if isinstance(result.get("response"),str) and "ok" in result["response"].lower() else 1)
PY
log "Ollama $OLLAMA_VERSION e modelo $OLLAMA_MODEL instalados; inferência local smoke test passou."

if [ ! -x "$NODE_DIR/bin/node" ] || [ "$("$NODE_DIR/bin/node" --version 2>/dev/null || true)" != "v$NODE_VERSION" ]; then
  CURRENT_STAGE=installing_node
  write_status running "$CURRENT_STAGE" "A instalar o Node.js local."
  case "$NODE_DIR" in "$BASE"/node-v*) ;; *) fail "caminho de instalação Node inválido" ;; esac
  [ ! -L "$NODE_DIR" ] || fail "o diretório Node existente é um symlink inseguro"
  rm -rf -- "$NODE_DIR"
  log "A descarregar Node.js $NODE_VERSION do domínio oficial nodejs.org."
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    "https://nodejs.org/dist/v$NODE_VERSION/$ARCHIVE" -o "$TMP/$ARCHIVE" || fail "download oficial Node.js falhou"
  printf '%s  %s\n' "$NODE_SHA256" "$TMP/$ARCHIVE" | sha256sum --check --status || fail "SHA-256 do Node.js não corresponde"
  tar -xJf "$TMP/$ARCHIVE" -C "$TMP" || fail "extração Node.js falhou"
  mv "$TMP/node-v$NODE_VERSION-linux-x64" "$NODE_DIR"
fi
[ "$("$NODE_DIR/bin/node" --version)" = "v$NODE_VERSION" ] || fail "versão Node instalada não corresponde"

CURRENT_STAGE=installing_openclaude
write_status running "$CURRENT_STAGE" "A instalar o OpenClaude e a ponte MCP."
if ! getent group solarminer-intelligence >/dev/null 2>&1; then addgroup --system solarminer-intelligence; fi
if ! getent passwd solarminer-intelligence >/dev/null 2>&1; then
  adduser --system --ingroup solarminer-intelligence --home /var/lib/solarminer-intelligence --no-create-home --shell /usr/sbin/nologin solarminer-intelligence
fi
install -d -o root -g solarminer-intelligence -m 0750 /var/lib/solarminer-intelligence
install -d -o solarminer-intelligence -g solarminer-intelligence -m 0750 /var/lib/solarminer-intelligence/work
install -d -o solarminer-intelligence -g solarminer-intelligence -m 0700 /var/lib/solarminer-intelligence/home
install -d -o root -g solarminer-intelligence -m 0750 "$APP_DIR"
install -d -o root -g solarminer-intelligence -m 0750 /usr/share/solarminer/intelligence-agent
install -d -o root -g solarminer-intelligence -m 0750 /usr/share/solarminer/intelligence-mcp
install -o root -g solarminer-intelligence -m 0640 /var/lib/solarminer/server.crt /usr/share/solarminer/intelligence-agent/gateway-ca.crt
OPENCLAUDE_READY=0
if [ -x "$APP_DIR/node_modules/.bin/openclaude" ]; then
  OPENCLAUDE_EXISTING=$(runuser -u solarminer-intelligence -- env HOME=/var/lib/solarminer-intelligence/home PATH="$NODE_DIR/bin:/usr/bin:/bin" \
    "$APP_DIR/node_modules/.bin/openclaude" --version 2>>"$LOG" | tail -n 1 || true)
  case "$OPENCLAUDE_EXISTING" in *"$OPENCLAUDE_VERSION"*) OPENCLAUDE_READY=1 ;; esac
fi
if [ "$OPENCLAUDE_READY" -ne 1 ]; then
  log "A instalar OpenClaude $OPENCLAUDE_VERSION e o cliente MCP oficial após validar a rede segura."
  chown solarminer-intelligence:solarminer-intelligence "$APP_DIR"
  runuser -u solarminer-intelligence -- env HOME=/var/lib/solarminer-intelligence/home PATH="$NODE_DIR/bin:/usr/bin:/bin" \
    "$NODE_DIR/bin/npm" install --prefix "$APP_DIR" --omit=dev --no-audit --no-fund \
    "@twigpine/openclaude@$OPENCLAUDE_VERSION" "@modelcontextprotocol/sdk@1.32.1" >>"$LOG" 2>&1 || fail "instalação npm OpenClaude/MCP falhou"
fi
OPENCLAUDE_VERSION_ACTUAL=$(runuser -u solarminer-intelligence -- env HOME=/var/lib/solarminer-intelligence/home PATH="$NODE_DIR/bin:/usr/bin:/bin" "$APP_DIR/node_modules/.bin/openclaude" --version 2>>"$LOG" | tail -n 1) || fail "OpenClaude não iniciou na verificação de versão"
case "$OPENCLAUDE_VERSION_ACTUAL" in *"$OPENCLAUDE_VERSION"*) ;; *) fail "versão OpenClaude inesperada: $OPENCLAUDE_VERSION_ACTUAL" ;; esac
CURRENT_STAGE=provisioning_credentials
write_status running "$CURRENT_STAGE" "A preparar a identidade local do Intelligence."
python3 - <<'PY' || fail "não foi possível provisionar a identidade de serviço do Intelligence"
import grp, hashlib, json, os, re, secrets, sqlite3, tempfile, uuid
from datetime import datetime, timezone

env_path = "/etc/solarminer/intelligence-agent.env"
client_path = "/etc/solarminer/intelligence-client.token"
mcp_token_path = "/usr/share/solarminer/intelligence-mcp/service.token"
db_path = "/var/lib/solarminer/gateway.db"
if os.path.islink("/etc/solarminer") or not os.path.isdir("/etc/solarminer"):
    raise SystemExit("INTELLIGENCE_CONFIG_DIRECTORY_UNSAFE")
service_group = grp.getgrnam("solarminer-intelligence").gr_gid
gateway_group = grp.getgrnam("solarminer").gr_gid

def atomic_secret(path, value, group):
    temporary = path + "." + uuid.uuid4().hex + ".tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o640)
    try:
        with os.fdopen(fd, "w", encoding="ascii") as stream:
            stream.write(value)
            stream.flush()
            os.fsync(stream.fileno())
        os.chown(temporary, 0, group)
        os.chmod(temporary, 0o640)
        os.replace(temporary, path)
        dirfd = os.open(os.path.dirname(path), os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try: os.fsync(dirfd)
        finally: os.close(dirfd)
    finally:
        try: os.unlink(temporary)
        except FileNotFoundError: pass

if os.path.exists(env_path):
    meta = os.lstat(env_path)
    if not os.path.isfile(env_path) or meta.st_uid != 0 or meta.st_gid != service_group or meta.st_mode & 0o037:
        raise SystemExit("INTELLIGENCE_SERVICE_ENV_UNSAFE")
    text = open(env_path, encoding="ascii").read()
    match = re.fullmatch(r"SOLARMINER_INTELLIGENCE_TOKEN=([A-Za-z0-9_-]{64,128})\nSOLARMINER_INTELLIGENCE_LOCAL_TOKEN=([A-Za-z0-9_-]{64,128})\nSOLARMINER_INTELLIGENCE_SESSION_ID=([0-9a-f-]{36})\n", text)
    if not match:
        raise SystemExit("INTELLIGENCE_SERVICE_ENV_INVALID")
    raw, local_token, session_id = match.groups()
else:
    raw, local_token = secrets.token_urlsafe(48), secrets.token_urlsafe(48)
    session_id = str(uuid.uuid4())
    atomic_secret(env_path, "SOLARMINER_INTELLIGENCE_TOKEN=" + raw + "\nSOLARMINER_INTELLIGENCE_LOCAL_TOKEN=" + local_token + "\nSOLARMINER_INTELLIGENCE_SESSION_ID=" + session_id + "\n", service_group)

now = datetime.now(timezone.utc).isoformat()
digest = hashlib.sha256(raw.encode()).hexdigest()
service_id = str(uuid.uuid5(uuid.NAMESPACE_URL, "solarminer-intelligence:" + digest))
with sqlite3.connect(db_path, timeout=5) as conn:
    conn.execute("BEGIN IMMEDIATE")
    inserted = conn.execute("INSERT OR IGNORE INTO intelligence_service_tokens(id,label,token_sha256,created_at) VALUES(?,?,?,?)",
                            (service_id, "SolarMiner Intelligence MCP", digest, now)).rowcount
    if inserted:
        conn.execute("INSERT INTO audit(occurred_at,actor_user_id,action,target,outcome,details_json) VALUES(?,NULL,?,?,?,?)",
                     (now, "intelligence.service_token.bootstrap", service_id, "success",
                      json.dumps({"scope":"read_only", "source":"first_install_bootstrap"}, separators=(",", ":"))))
    conn.commit()
if os.path.exists(client_path):
    meta = os.lstat(client_path)
    if not os.path.isfile(client_path) or meta.st_uid != 0 or meta.st_gid != gateway_group or meta.st_mode & 0o027:
        raise SystemExit("INTELLIGENCE_CLIENT_TOKEN_UNSAFE")
atomic_secret(client_path, local_token + "\n", gateway_group)
atomic_secret(mcp_token_path, "SOLARMINER_INTELLIGENCE_TOKEN=" + raw + "\n", service_group)
PY
chown -R root:solarminer-intelligence "$BASE"
find "$BASE" -type d -exec chmod 0750 {} +
find "$BASE" -type f -perm /111 -exec chmod 0750 {} +
find "$BASE" -type f ! -perm /111 -exec chmod 0640 {} +

# Give the agent a source checkout below its systemd-writable workspace. This
# clone is public and read-only at fetch time; it contains no credentials or
# production database. The OpenClaude tool gate confines edits to the candidate
# tree and the Gateway service sandbox still limits writes to this workspace.
SOURCE_ROOT=/var/lib/solarminer-intelligence/work/source
SOURCE_CANDIDATE="$SOURCE_ROOT/solarminer-gateway-code02-v0.6.9-candidate"
if [ ! -d "$SOURCE_ROOT/.git" ]; then
  SOURCE_TMP=$(mktemp -d /var/lib/solarminer-intelligence/work/.source-bootstrap.XXXXXX)
  chown solarminer-intelligence:solarminer-intelligence "$SOURCE_TMP"
  if runuser -u solarminer-intelligence -- env HOME=/var/lib/solarminer-intelligence/home GIT_TERMINAL_PROMPT=0 \
      /usr/bin/git clone --depth 1 --filter=blob:none --branch main \
      https://github.com/solargualdimpais-bot/TheSolarMiner.git "$SOURCE_TMP" >>"$LOG" 2>&1; then
    mv "$SOURCE_TMP" "$SOURCE_ROOT"
    log "Checkout isolado do Gateway preparado para desenvolvimento local."
  else
    log "AVISO: checkout de desenvolvimento indisponível; o Intelligence inicia em modo de leitura."
  fi
fi
if [ ! -d "$SOURCE_CANDIDATE" ]; then
  log "AVISO: candidato Gateway não existe no checkout; edição de código ficará indisponível."
fi
CURRENT_STAGE=starting_agent
write_status running "$CURRENT_STAGE" "A iniciar e verificar o agente Intelligence."
printf 'node=%s\nopenclaude=%s\nollama=%s\nmodel=%s\n' "$NODE_VERSION" "$OPENCLAUDE_VERSION" "$OLLAMA_VERSION" "$OLLAMA_MODEL" > "$TMP/runtime-installed"
install -o root -g root -m 0644 /dev/null "$READY_FILE"
systemctl enable solarminer-intelligence.service || fail "não foi possível ativar o arranque do serviço residente"
if systemctl is-active --quiet solarminer-intelligence.service; then
  systemctl restart solarminer-intelligence.service || fail "Node/OpenClaude foram instalados, mas o serviço residente não reiniciou"
else
  systemctl start solarminer-intelligence.service || fail "Node/OpenClaude foram instalados, mas o serviço residente não iniciou"
fi
systemctl is-active --quiet solarminer-intelligence.service || fail "serviço OpenClaude não ficou ativo"
install -o root -g root -m 0644 "$TMP/runtime-installed" "$STATE"
systemctl disable --now solarminer-intelligence-bootstrap.timer >/dev/null 2>&1 || true
CURRENT_STAGE=complete
write_status completed "$CURRENT_STAGE" "O Ollama, o modelo e o agente OpenClaude estão instalados e ativos." 100
log "Node.js $NODE_VERSION, OpenClaude $OPENCLAUDE_VERSION, Ollama $OLLAMA_VERSION e $OLLAMA_MODEL instalados; serviço residente confirmado ativo."
