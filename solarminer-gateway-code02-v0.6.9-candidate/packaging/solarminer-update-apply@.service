[Unit]
Description=SolarMiner verified update operation %i
After=local-fs.target solarminer-recovery.service
OnFailure=solarminer-update-failure-report.service
ConditionPathExists=/opt/solarminer/current
RequiresMountsFor=/var/lib/solarminer

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/sbin/solarminer-update-apply --operation %i
ExecStartPre=/usr/bin/solarminer-data-volume-check
# Applying, restarting and, if needed, rolling back includes separate bounded
# service operations plus the new/previous release health checks. Keep systemd
# from killing the transaction while it is restoring a known-good release.
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/solarminer /var/lib/solarminer /usr/bin /usr/sbin /usr/lib/solarminer-gateway /usr/share/solarminer/intelligence-agent /usr/share/solarminer/intelligence-mcp /usr/lib/systemd/system
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
