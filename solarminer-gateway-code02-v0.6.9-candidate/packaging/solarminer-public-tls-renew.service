[Unit]
Description=Issue or renew the SolarMiner Gateway public-IP HTTPS certificate
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/solarminer-public-tls-renew
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/solarminer/certbot /etc/letsencrypt /etc/solarminer /var/lib/letsencrypt /var/log/letsencrypt /var/log/nginx
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
