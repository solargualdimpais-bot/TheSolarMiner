[Unit]
Description=Independent SolarMiner Gateway and Nginx health recovery
After=local-fs.target
RequiresMountsFor=/var/lib/solarminer

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONPATH=/opt/solarminer/current/usr/lib/solarminer-gateway
Environment=SOLARMINER_DATA_DIR=/var/lib/solarminer
ExecStart=/usr/bin/python3 -m solarminer_gateway.health_watchdog
ExecStartPre=/usr/bin/solarminer-data-volume-check
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solarminer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=60
