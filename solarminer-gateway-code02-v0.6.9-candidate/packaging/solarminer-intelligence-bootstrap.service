[Unit]
Description=Install verified SolarMiner Intelligence runtime after Tailscale and TLS readiness
After=network-online.target tailscaled.service nginx.service solarminer-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/solarminer-intelligence-bootstrap
# The bootstrap downloads a multi-gigabyte local model. Allow slower links to
# finish the verified pull instead of terminating the installer after 15 min.
TimeoutStartSec=2h
UMask=0077
Environment=HOME=/root
NoNewPrivileges=true
# This root one-shot installs verified system packages (Ollama, Node, and
# OpenClaude) after Tailscale and TLS checks. Filesystem sandboxing here would
# block writes to /usr and /etc and fail before the runtime is installed.
# The long-running Intelligence agent remains separately sandboxed.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
