[Unit]
Description=SolarMiner restricted update helper broker socket

[Socket]
ListenStream=/run/solarminer/update-broker.sock
SocketUser=solarminer
SocketGroup=solarminer
SocketMode=0600
DirectoryMode=0755
Accept=yes
Service=solarminer-update-broker@.service
RemoveOnStop=true
MaxConnections=4

[Install]
WantedBy=sockets.target
