[Unit]
Description=Daily signed SolarMiner release check
Documentation=file:/usr/share/doc/solarminer-gateway/UPDATE_AND_ROLLBACK.md
After=network-online.target solarminer-gateway.service
Wants=network-online.target

[Service]
Type=oneshot
User=solarminer
Group=solarminer
ExecStart=/usr/bin/solarminer-update-check-daily
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solarminer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
