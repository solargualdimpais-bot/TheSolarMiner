#!/bin/sh
set -eu
TAILSCALE=/usr/bin/tailscale
CONFIG=/etc/nginx/conf.d/solarminer-tailscale.conf
CERT=/etc/solarminer/tailscale.crt
KEY=/etc/solarminer/tailscale.key
LOG=/var/log/solarminer-tailscale-cert.log
mkdir -p /var/log
touch "$LOG"
chmod 0600 "$LOG"
log() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" | tee -a "$LOG"; }
fail() { log "ERROR: $*"; exit 1; }
[ -x "$TAILSCALE" ] || { log "Tailscale is not installed yet; certificate setup will retry."; exit 0; }
status=$($TAILSCALE status --json 2>/dev/null) || { log "Tailscale is not authenticated/connected yet; certificate setup will retry."; exit 0; }
dns_name=$(printf '%s' "$status" | /usr/bin/python3 -c '
import json,re,sys
d=json.load(sys.stdin); s=d.get("Self") or {}; n=(s.get("DNSName") or "").rstrip(".").lower()
if d.get("BackendState") != "Running" or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\.ts\.net", n): raise SystemExit(1)
print(n)
') || { log "No Tailscale MagicDNS name is active; certificate setup will retry."; exit 0; }
cert_valid=0
if [ -s "$CERT" ] && [ -s "$KEY" ] && openssl x509 -in "$CERT" -noout -checkhost "$dns_name" >/dev/null 2>&1 &&
   openssl x509 -in "$CERT" -noout -checkend 259200 >/dev/null 2>&1; then
  cert_valid=1
fi
work=$(mktemp -d /etc/solarminer/.tailscale-cert.XXXXXX)
trap 'rm -rf "$work"' EXIT HUP INT TERM
certificate_changed=0
if [ "$cert_valid" -ne 1 ]; then
  log "Requesting/renewing HTTPS certificate for configured Tailscale MagicDNS identity."
  "$TAILSCALE" cert --min-validity=72h --cert-file="$work/tailscale.crt" --key-file="$work/tailscale.key" "$dns_name" >>"$LOG" 2>&1 || {
    log "Tailscale certificate request failed. Enable HTTPS certificates for this tailnet in its admin console; the timer will retry."
    exit 0
  }
  [ -s "$work/tailscale.crt" ] && [ -s "$work/tailscale.key" ] || fail "certificate_files_missing"
  openssl x509 -in "$work/tailscale.crt" -noout -checkhost "$dns_name" >/dev/null 2>&1 || fail "certificate_hostname_mismatch"
  install -o root -g root -m 0644 "$work/tailscale.crt" "$CERT.new"
  install -o root -g root -m 0600 "$work/tailscale.key" "$KEY.new"
  mv -f "$CERT.new" "$CERT"
  mv -f "$KEY.new" "$KEY"
  certificate_changed=1
fi
cat >"$work/nginx.conf" <<EOF
server {
    listen 443 ssl;
    server_name $dns_name;
    ssl_certificate $CERT;
    ssl_certificate_key $KEY;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 3m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;
    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_ssl_trusted_certificate /var/lib/solarminer/server.crt;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_name localhost;
        proxy_ssl_server_name on;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For \$remote_addr;
    }
}
EOF
if [ "$certificate_changed" -eq 0 ] && cmp -s "$work/nginx.conf" "$CONFIG"; then
  exit 0
fi
install -o root -g root -m 0644 "$work/nginx.conf" "$CONFIG.new"
had_previous_config=0
if [ -f "$CONFIG" ] && [ ! -L "$CONFIG" ]; then
  cp -p "$CONFIG" "$work/nginx.previous.conf"
  had_previous_config=1
fi
mv -f "$CONFIG.new" "$CONFIG"
if ! nginx -t >>"$LOG" 2>&1; then
  if [ "$had_previous_config" -eq 1 ]; then
    mv -f "$work/nginx.previous.conf" "$CONFIG"
    log "Rejected Tailscale Nginx candidate; previous configuration restored."
  else
    rm -f "$CONFIG"
    log "Rejected Tailscale Nginx candidate; no previous configuration existed."
  fi
  fail "nginx_configuration_invalid; see preceding nginx -t output"
fi
systemctl reload nginx.service || fail "nginx_reload_failed"
log "HTTPS certificate and Nginx Tailscale endpoint are ready."
