[Unit]
Description=Issue or renew the SolarMiner Gateway Tailscale HTTPS certificate
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service nginx.service
RequiresMountsFor=/var/lib/solarminer

[Service]
Type=oneshot
ExecStart=/usr/sbin/solarminer-tailscale-cert
ExecStartPre=/usr/bin/solarminer-data-volume-check
TimeoutStartSec=3min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/solarminer /etc/nginx/conf.d /var/log /run
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
