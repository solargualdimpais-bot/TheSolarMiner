#!/bin/sh
set -eu
TAILSCALE=/usr/bin/tailscale
[ -x "$TAILSCALE" ] || { printf '%s\n' '{"started":false,"connected":false,"auth_url":null}'; exit 1; }
status=$($TAILSCALE status --json 2>/dev/null) || status='{}'
connected=$(printf '%s' "$status" | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin); print("true" if d.get("BackendState")=="Running" else "false")' 2>/dev/null || printf false)
if [ "$connected" = true ]; then
  printf '%s\n' '{"started":true,"connected":true,"auth_url":null}'
  exit 0
fi
output=$("$TAILSCALE" up 2>&1) || {
  printf '%s\n' '{"started":false,"connected":false,"auth_url":null}'
  exit 1
}
auth_url=$(printf '%s' "$output" | /usr/bin/python3 -c '
import re, sys
text = sys.stdin.read(16384)
match = re.search(r"https://login\.tailscale\.com/a/[A-Za-z0-9_-]{6,128}", text)
print(match.group(0) if match else "")
 ')
if [ "$connected" != true ] && [ -z "$auth_url" ]; then
  printf '%s\n' '{"started":false,"connected":false,"auth_url":null}'
  exit 1
fi
/usr/bin/python3 - "$auth_url" <<'PY'
import json, sys
print(json.dumps({"started": True, "connected": False, "auth_url": sys.argv[1] or None}, separators=(",", ":")))
PY
